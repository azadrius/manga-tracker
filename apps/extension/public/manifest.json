{
  "manifest_version": 3,
  "name": "Manga Tracker",
  "description": "Enregistre automatiquement le dernier chapitre lu de tes mangas.",
  "version": "0.1.0",
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Manga Tracker" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": ["https://firestore.googleapis.com/*"]
}
